# ============================================================
# XJ-Editor（Electron + Vue 3 + Vite + TypeScript）
# ============================================================

# ---------- 依赖 ----------
node_modules/
.pnp
.pnp.js

# ---------- 构建产物 ----------
# Vite 前端构建输出（vite.config.ts: outDir = dist）
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# electron-builder 打包输出（package.json: directories.output）
release_app/

# pdf.js 运行时资源（cmaps / standard_fonts）
# 由 scripts/copy-pdf-assets.cjs 生成，npm run dev / build 前自动执行，无需入库
public/pdfjs/

# ---------- 环境变量 ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- 日志与临时调试文件 ----------
.out/
logs/
*.log
*.err
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
test-caret.html

# ---------- 测试与覆盖率 ----------
coverage/
.nyc_output/

# ---------- 缓存 ----------
.cache/
.parcel-cache/
.eslintcache
electron-builder.cache/

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- 说明 ----------
# 以下目录/文件需要入库，请勿忽略：
#   build/           打包用图标（build/icon.ico、build/icon.png）
#   scripts/         构建脚本（copy-pdf-assets.cjs、after-pack.cjs）
#   docs/            项目设计文档
#   package-lock.json  依赖锁定，保证构建可复现
release_build/
